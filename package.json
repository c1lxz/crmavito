{
  "name": "crmavito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 127.0.0.1",
    "avito:local-agent": "tsx scripts/avito-local-agent.ts",
    "avito:local-browser-agent": "cross-env AVITO_LOCAL_AGENT_BROWSER=1 tsx scripts/avito-local-agent.ts",
    "avito:install-local-agent": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-avito-local-agent-task.ps1",
    "content-machine:flow-agent": "tsx scripts/flow-local-agent.ts",
    "content-machine:install-flow-agent": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-flow-local-agent-task.ps1",
    "avito:sync-worker": "node scripts/avito-sync-worker.js",
    "telegram:notify-worker": "node scripts/telegram-notify-worker.js",
    "users:provision-credentials": "node scripts/provision-user-credentials.js",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
