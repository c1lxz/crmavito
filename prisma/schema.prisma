generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum OrderStatus {
  ACCEPTED
  SHIPPED
  RECEIVED
  RETURNING
  RETURNED
}

enum ReturnStatus {
  RETURNING
  RETURNED
  CANCELLED
}

enum ExpenseCategory {
  PURCHASE
  ADVERTISING
  LOGISTICS
  SALARY
  PACKAGING
  AVITO_COMMISSION
  OTHER
}

enum AuditEntityType {
  ORDER
  RETURN
  EXPENSE
  PRODUCT
  COUNTERPARTY
  USER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  passwordHash String?
  telegramId   String?   @unique
  role         UserRole  @default(MANAGER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders     Order[]
  expenses   Expense[]
  auditLogs  AuditLog[]

  @@map("users")
}

model Product {
  id                 String    @id @default(uuid())
  name               String
  salePrice          Decimal   @db.Decimal(12, 2)
  avitoListingUrl    String?
  avitoListingStatus String?
  avitoItemId        String?   @unique
  imageUrl           String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders   Order[]
  orderItems OrderItem[]
  returns  Return[]

  @@index([name])
  @@map("products")
}

model Counterparty {
  id          String  @id @default(uuid())
  name        String
  contactInfo String?
  comment     String?
  createdAt   DateTime @default(now())

  orders Order[]

  @@map("counterparties")
}

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique
  productId            String
  productNameSnapshot  String
  variant              String?
  size                 String?
  quantity             Int
  salePriceAtOrder     Decimal     @db.Decimal(12, 2)
  counterpartyId       String
  purchasePricePerUnit Decimal     @db.Decimal(12, 2)
  purchaseComment      String?
  trackingNumber       String
  carrier              String?
  orderDate            DateTime    @db.Date
  shippingDate         DateTime?   @db.Date
  receivedAt           DateTime?
  destinationCity      String?
  status               OrderStatus @default(ACCEPTED)
  logisticsCost        Decimal     @default(0) @db.Decimal(12, 2)
  commissionCost       Decimal     @default(0) @db.Decimal(12, 2)
  otherCosts           Decimal     @default(0) @db.Decimal(12, 2)
  isDeleted            Boolean     @default(false)
  createdByUserId      String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product      Product      @relation(fields: [productId], references: [id])
  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])
  returns      Return[]
  items        OrderItem[]
  auditLogs    AuditLog[]

  @@index([status])
  @@index([orderDate])
  @@index([receivedAt])
  @@index([trackingNumber])
  @@map("orders")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  productId            String
  productNameSnapshot  String
  variant              String?
  size                 String?
  quantity             Int
  salePriceAtOrder     Decimal  @db.Decimal(12, 2)
  purchasePricePerUnit Decimal  @db.Decimal(12, 2)
  imageUrls             String[] @default([])
  position              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Return {
  id             String       @id @default(uuid())
  orderId        String
  productId      String
  trackingNumber String
  status         ReturnStatus @default(RETURNING)
  shippingDate   DateTime?    @db.Date
  returnDate     DateTime?    @db.Date
  reason         String
  comment        String?
  createdAt      DateTime     @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([status])
  @@index([orderId])
  @@map("returns")
}

model Expense {
  id              String          @id @default(uuid())
  date            DateTime        @db.Date
  category        ExpenseCategory
  title           String?
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   String?
  comment         String?
  createdByUserId String
  createdAt       DateTime        @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([date])
  @@index([category])
  @@map("expenses")
}

model AuditLog {
  id         String          @id @default(uuid())
  entityType AuditEntityType
  entityId   String
  userId     String
  timestamp  DateTime        @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  createdAt  DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [entityId], references: [id], map: "audit_log_order_fk")

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
