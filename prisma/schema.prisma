generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum OrderStatus {
  ACCEPTED
  SHIPPED
  RECEIVED
  RETURNING
  RETURNED
  CANCELLED
}

enum Marketplace {
  AVITO
  WB
}

enum ReturnStatus {
  RETURNING
  RETURNED
  CANCELLED
}

enum ExpenseCategory {
  PURCHASE
  ADVERTISING
  LOGISTICS
  SALARY
  PACKAGING
  AVITO_COMMISSION
  OTHER
}

enum AuditEntityType {
  ORDER
  RETURN
  EXPENSE
  PRODUCT
  COUNTERPARTY
  AVITO_PROFILE
  USER
}

enum TaskStatus {
  OPEN
  COMPLETED
}

enum NoteVisibility {
  ALL
  SELECTED
}

model User {
  id                       String    @id @default(uuid())
  name                     String
  login                    String?   @unique
  email                    String?   @unique
  passwordHash             String?
  telegramId               String?   @unique
  telegramUsername         String?
  credentialsDeliveredAt   DateTime?
  credentialsDeliveryError String?
  role                     UserRole  @default(MANAGER)
  isActive                 Boolean   @default(true)
  createdAt                DateTime  @default(now())

  orders                       Order[]
  expenses                     Expense[]
  auditLogs                    AuditLog[]
  createdTasks                 Task[]                        @relation("TaskCreatedBy")
  assignedTasks                Task[]                        @relation("TaskAssignedTo")
  taskAssignments              TaskAssignee[]
  completedTasks               Task[]                        @relation("TaskCompletedBy")
  notesCreated                 Note[]                        @relation("NoteCreatedBy")
  noteAccess                   NoteViewer[]
  noteMentions                 NoteMention[]
  privateWbPublicationProfiles WbPrivatePublicationProfile[]

  @@map("users")
}

model WbPrivatePublicationProfile {
  id             String   @id @default(uuid())
  normalizedName String   @unique
  displayName    String
  ownerUserId    String
  createdAt      DateTime @default(now())

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@map("wb_private_publication_profiles")
}

model Task {
  id                String     @id @default(uuid())
  title             String
  description       String?
  status            TaskStatus @default(OPEN)
  scheduledAt       DateTime?
  dueAt             DateTime
  assigneeUserId    String
  createdByUserId   String
  completedByUserId String?
  completedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  assignee             User                      @relation("TaskAssignedTo", fields: [assigneeUserId], references: [id])
  createdBy            User                      @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  completedBy          User?                     @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])
  assignees            TaskAssignee[]
  attachments          TaskAttachment[]
  notification         TaskNotification?
  notificationCleanups TaskNotificationCleanup[]

  @@index([status, dueAt])
  @@index([assigneeUserId])
  @@index([scheduledAt])
  @@map("tasks")
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  name       String
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

model TaskAssignee {
  id                 String    @id @default(uuid())
  taskId             String
  userId             String
  notificationStatus String    @default("PENDING")
  attempts           Int       @default(0)
  lastError          String?
  notifiedAt         DateTime?
  telegramChatId     String?
  telegramMessageId  Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskNotification {
  id                  String    @id @default(uuid())
  taskId              String    @unique
  status              String    @default("PENDING")
  attempts            Int       @default(0)
  nextAttemptAt       DateTime  @default(now())
  processingStartedAt DateTime?
  lastError           String?
  sentAt              DateTime?
  telegramChatId      String?
  telegramMessageId   Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("task_notifications")
}

model TaskNotificationCleanup {
  id                String   @id @default(uuid())
  taskId            String
  telegramChatId    String
  telegramMessageId Int
  createdAt         DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, telegramChatId, telegramMessageId])
  @@index([taskId])
  @@map("task_notification_cleanups")
}

model Product {
  id                 String    @id @default(uuid())
  name               String
  normalizedName     String?
  salePrice          Decimal   @db.Decimal(12, 2)
  avitoListingUrl    String?
  avitoListingStatus String?
  avitoItemId        String?   @unique
  imageUrl           String?
  lastSyncedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  orders        Order[]
  orderItems    OrderItem[]
  returns       Return[]
  notes         NoteProduct[]
  avitoListings ProductAvitoListing[]

  @@index([name])
  @@index([normalizedName])
  @@map("products")
}

model ProductAvitoListing {
  id             String   @id @default(uuid())
  productId      String
  avitoProfileId String
  avitoItemId    String
  listingUrl     String?
  listingStatus  String?
  price          Decimal  @db.Decimal(12, 2)
  imageUrl       String?
  lastSyncedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  avitoProfile AvitoProfile @relation(fields: [avitoProfileId], references: [id], onDelete: Cascade)

  @@unique([avitoProfileId, avitoItemId])
  @@index([productId])
  @@index([avitoProfileId, listingStatus])
  @@map("product_avito_listings")
}

model Note {
  id              String         @id @default(uuid())
  title           String
  content         String
  visibility      NoteVisibility @default(ALL)
  createdByUserId String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy   User             @relation("NoteCreatedBy", fields: [createdByUserId], references: [id])
  viewers     NoteViewer[]
  mentions    NoteMention[]
  attachments NoteAttachment[]
  products    NoteProduct[]

  @@index([createdByUserId])
  @@index([visibility, updatedAt])
  @@map("notes")
}

model NoteViewer {
  id     String @id @default(uuid())
  noteId String
  userId String

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("note_viewers")
}

model NoteMention {
  id                  String    @id @default(uuid())
  noteId              String
  userId              String
  status              String    @default("PENDING")
  attempts            Int       @default(0)
  nextAttemptAt       DateTime  @default(now())
  processingStartedAt DateTime?
  lastError           String?
  notifiedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([status, nextAttemptAt])
  @@index([userId])
  @@map("note_mentions")
}

model NoteAttachment {
  id         String   @id @default(uuid())
  noteId     String
  name       String
  storageKey String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_attachments")
}

model NoteProduct {
  id        String @id @default(uuid())
  noteId    String
  productId String

  note    Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([noteId, productId])
  @@index([productId])
  @@map("note_products")
}

model Counterparty {
  id          String   @id @default(uuid())
  name        String
  contactInfo String?
  comment     String?
  createdAt   DateTime @default(now())

  orders Order[]

  @@map("counterparties")
}

model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique
  productId            String
  productNameSnapshot  String
  variant              String?
  size                 String?
  quantity             Int
  salePriceAtOrder     Decimal     @db.Decimal(12, 2)
  counterpartyId       String
  avitoProfileId       String?
  purchasePricePerUnit Decimal     @db.Decimal(12, 2)
  purchaseComment      String?
  trackingNumber       String
  carrier              String?
  orderDate            DateTime    @db.Date
  shippingDate         DateTime?   @db.Date
  receivedAt           DateTime?
  destinationCity      String?
  status               OrderStatus @default(ACCEPTED)
  marketplace          Marketplace @default(AVITO)
  logisticsCost        Decimal     @default(0) @db.Decimal(12, 2)
  commissionCost       Decimal     @default(0) @db.Decimal(12, 2)
  otherCosts           Decimal     @default(0) @db.Decimal(12, 2)
  isDeleted            Boolean     @default(false)
  createdByUserId      String
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product      Product            @relation(fields: [productId], references: [id])
  counterparty Counterparty       @relation(fields: [counterpartyId], references: [id])
  avitoProfile AvitoProfile?      @relation(fields: [avitoProfileId], references: [id])
  createdBy    User               @relation(fields: [createdByUserId], references: [id])
  returns      Return[]
  items        OrderItem[]
  auditLogs    AuditLog[]
  notification OrderNotification?

  @@index([status])
  @@index([marketplace])
  @@index([orderDate])
  @@index([avitoProfileId])
  @@index([receivedAt])
  @@index([trackingNumber])
  @@map("orders")
}

model AvitoProfile {
  id           String   @id @default(uuid())
  name         String   @unique
  color        String?
  accountId    String?
  clientId     String?
  clientSecret String?
  reportEmail  String?
  contactPhone String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders          Order[]
  productListings ProductAvitoListing[]

  @@index([accountId])
  @@index([clientId])
  @@map("avito_profiles")
}

model OrderNotification {
  id                  String    @id @default(uuid())
  orderId             String    @unique
  status              String    @default("PENDING")
  attempts            Int       @default(0)
  sentBatches         Int       @default(0)
  nextAttemptAt       DateTime  @default(now())
  processingStartedAt DateTime?
  lastError           String?
  sentAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("order_notifications")
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  productId            String
  productNameSnapshot  String
  variant              String?
  size                 String?
  quantity             Int
  salePriceAtOrder     Decimal  @db.Decimal(12, 2)
  purchasePricePerUnit Decimal  @db.Decimal(12, 2)
  imageUrls            String[] @default([])
  sourceReturnId       String?  @unique
  position             Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])
  sourceReturn Return? @relation("ReturnSource", fields: [sourceReturnId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Return {
  id                  String       @id @default(uuid())
  orderId             String?
  productId           String
  productNameSnapshot String       @default("")
  variant             String?
  size                String?
  trackingNumber      String
  status              ReturnStatus @default(RETURNING)
  shippingDate        DateTime?    @db.Date
  returnDate          DateTime?    @db.Date
  reason              String
  comment             String?
  createdAt           DateTime     @default(now())

  order            Order?      @relation(fields: [orderId], references: [id])
  product          Product     @relation(fields: [productId], references: [id])
  usedByOrderItems OrderItem[] @relation("ReturnSource")

  @@index([status])
  @@index([orderId])
  @@map("returns")
}

model Expense {
  id              String          @id @default(uuid())
  date            DateTime        @db.Date
  category        ExpenseCategory
  title           String?
  amount          Decimal         @db.Decimal(12, 2)
  paymentMethod   String?
  comment         String?
  createdByUserId String
  createdAt       DateTime        @default(now())

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([date])
  @@index([category])
  @@map("expenses")
}

model AuditLog {
  id         String          @id @default(uuid())
  entityType AuditEntityType
  entityId   String
  userId     String
  timestamp  DateTime        @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  createdAt  DateTime        @default(now())

  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [entityId], references: [id], map: "audit_log_order_fk")

  @@index([entityId])
  @@index([entityType])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
